{
  "name": "photobook-as-code",
  "image": "ubuntu:24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "nodeGypDependencies": true
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/stu-bell/devcontainer-features/open-code:0": {
      "version": "latest"
    },
    "ghcr.io/jrussellsmyth/devcontainer-features/openspec:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "latest"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "ms-vscode.vscode-json"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n"
      }
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/Pictures,target=/mnt/pictures,type=bind,readonly",
    "source=${localEnv:HOME}/Downloads,target=/mnt/downloads,type=bind",
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/root/.claude"
  },
  "postCreateCommand": "apt-get update && apt-get install -y fonts-dejavu-extra chromium-browser",
  "remoteUser": "root"
}
